# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/__screenshots__/
/.playwright-mcp/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build
/output/
/uploads/

# base de datos local (datos de usuario, no va al repo)
/prisma/dev.db
/prisma/*.db
/prisma/*.db-journal

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime de Claude Code (lock con PID de sesion, no versionable)
/.claude/scheduled_tasks.lock
