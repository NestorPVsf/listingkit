# Copia este archivo a .env y ajusta si hace falta.
DATABASE_URL="file:./prisma/dev.db"

# Nombre del producto tal y como lo ve la agencia. Cada instalacion puede llevar
# el suyo; si no se declara, sale "ListingKit".
# NEXT_PUBLIC_APP_NAME="ListingKit"

# --- Opcionales (server-only, NO se exponen al cliente) ---

# Reescritura de texto con IA. APAGADA por defecto: sin AI_TEXT_ENABLED=1 no se
# llama a ningun servicio externo y el boton ni siquiera aparece.
#
# El adaptador habla la API de chat de OpenAI, asi que sirve cualquier proveedor
# compatible. Ejemplos de BASE_URL:
#   OpenAI      https://api.openai.com/v1        (es el valor por defecto)
#   OpenRouter  https://openrouter.ai/api/v1
#   Local       http://localhost:11434/v1        (Ollama y similares)
#
# AI_TEXT_MODEL no tiene valor por defecto en el CODIGO a proposito: un modelo
# fijo ahi dentro envejece en silencio y un dia apunta a algo retirado. Se
# declara aqui, donde se ve y se revisa.
#
# Elegido para esta instalacion: openai/gpt-5.6-terra (catalogo OpenRouter
# consultado el 2026-08-03: 0,10 $/Mtok entrada, 6 $/Mtok salida). Una
# reescritura son ~1.000 tokens de entrada y ~300 de salida, o sea ~0,002 $:
# mil reescrituras cuestan unos 2 $. El coste NO es el criterio a estas
# cifras, asi que se elige por calidad de instruccion y latencia.
#   Mas barato y algo mas simple:  openai/gpt-5.6-luna       (0,10 / 0,60 $)
#   Alternativa rapida de Google:  google/gemini-3.1-flash-lite
#   Si quieres prosa mas cuidada:  anthropic/claude-sonnet-5 (2 / 10 $)
# Revisa el catalogo cada pocos meses: los ids cambian y uno retirado da un
# 404 confuso.
# AI_TEXT_ENABLED="1"
# AI_TEXT_API_KEY=""   # server-only — NUNCA la pegues en ningun otro sitio
# AI_TEXT_MODEL=""
# AI_TEXT_BASE_URL="https://openrouter.ai/api/v1"

# TTS_API_KEY=""     # server-only — key del proveedor de texto-a-voz (pendiente)

# Secreto para firmar el token efimero de la ruta de render (/preview).
# Opcional: si no se declara, cada proceso genera el suyo al arrancar, que es
# lo correcto con UNA instancia. Con varias, fijalo aqui o las capturas de un
# proceso no validaran contra la ruta servida por otro.
# RENDER_PREVIEW_SECRET=""

# Contraseña de operador (obligatoria en produccion: sin ella la app responde
# 503 a todo). Generala con `npm run set-password`, que imprime la linea a
# pegar aqui. Cambiarla invalida las sesiones abiertas.
# APP_PASSWORD_HASH="scrypt$..."
