# Copia este archivo a `.env`. Tal cual, sin tocar nada, arranca en local.
# Todo lo que viene comentado es opcional: la aplicacion funciona sin ello.

# ---------------------------------------------------------------------------
# Basico
# ---------------------------------------------------------------------------

# SQLite en un fichero del proyecto. `npx prisma migrate deploy` lo crea.
DATABASE_URL="file:./prisma/dev.db"

# Nombre del producto tal y como lo ve la agencia. Cada instalacion puede llevar
# el suyo; si no se declara, sale "ListingKit".
# NEXT_PUBLIC_APP_NAME="ListingKit"

# ---------------------------------------------------------------------------
# Produccion — sin esto la aplicacion NO se abre
# ---------------------------------------------------------------------------

# Contraseña de operador. Sin ella la app responde 503 a todo, a proposito: una
# instalacion sin candado en una red es peor que una que no arranca. Generala
# con `npm run set-password`, que imprime la linea lista para pegar aqui.
# Cambiarla invalida las sesiones abiertas.
#
# Ademas hay que servir por HTTPS: la cookie de sesion va marcada `Secure`, asi
# que sobre HTTP el navegador no la guarda y no hay forma de entrar.
# APP_PASSWORD_HASH="scrypt$..."

# URL por la que el renderizador se visita a si mismo para capturar las piezas.
# Por defecto http://localhost:3000. Si sirves en otro puerto o detras de un
# dominio, ajustala: si apunta a donde no hay nada, las capturas fallan y el
# sintoma no menciona esta variable.
# RENDER_BASE_URL="https://tu-dominio.example"

# Carpeta donde se escriben las piezas generadas. Relativa al proyecto o
# absoluta. Por defecto `output/`.
#
# Con UNA instancia no hay nada que decidir. Con VARIAS tiene que ser
# almacenamiento COMPARTIDO: los ficheros se escriben en disco y una instancia
# no puede servir la descarga de algo que escribio otra en el suyo.
# RENDER_OUTPUT_DIR="output"

# Secreto para firmar el token efimero de la ruta de render (`/preview`).
# Opcional: si no se declara, cada proceso genera el suyo al arrancar, que es lo
# correcto con UNA instancia. Con varias, fijalo aqui o las capturas de un
# proceso no validaran contra la ruta servida por otro. Minimo 32 caracteres.
# RENDER_PREVIEW_SECRET=""

# ---------------------------------------------------------------------------
# Video
# ---------------------------------------------------------------------------

# De donde sale la locucion del video. Por defecto "manual-upload".
#   manual-upload    el operador sube su propio audio (lo que hace hoy la UI)
#   none             video sin voz: solo musica y texto en pantalla
#   local | api-env  reservados para un proveedor de texto-a-voz
# Un valor que no sea uno de esos hace fallar el arranque, en vez de generar
# videos mudos sin avisar.
# VIDEO_TTS_MODE="manual-upload"

# ---------------------------------------------------------------------------
# Reescritura de texto con IA — OPCIONAL y APAGADA
# ---------------------------------------------------------------------------
#
# Sin AI_TEXT_ENABLED=1 no se llama a ningun servicio externo y el boton ni
# siquiera aparece en la interfaz. El camino principal —plantillas locales
# deterministas— no depende de esto.
#
# Cuando se enciende, la IA REESCRIBE un texto que ya existe: no genera desde
# cero y no puede introducir ningun numero que no venga de la ficha o del texto
# original. Se comprueba despues de responder, y si lo intenta se descarta la
# respuesta entera.
#
# El adaptador habla la API de chat de OpenAI, asi que sirve cualquier proveedor
# compatible. Ejemplos de BASE_URL:
#   OpenAI      https://api.openai.com/v1        (es el valor por defecto)
#   OpenRouter  https://openrouter.ai/api/v1
#   Local       http://localhost:11434/v1        (Ollama y similares)
#
# AI_TEXT_MODEL no tiene valor por defecto en el CODIGO a proposito: un modelo
# fijo ahi dentro envejece en silencio y un dia apunta a algo retirado. Se
# declara aqui, donde se ve y se revisa.
#
# Sobre el coste: una reescritura son ~1.000 tokens de entrada y ~300 de salida.
# Con un modelo de gama media son decimas de centimo, asi que mil reescrituras
# cuestan un par de euros — a estas cifras el coste no deberia ser el criterio.
# Elige por calidad de instruccion y latencia, y revisa el catalogo de tu
# proveedor cada pocos meses: los identificadores cambian, y uno retirado
# devuelve un 404 confuso.
# AI_TEXT_ENABLED="1"
# AI_TEXT_API_KEY=""   # server-only — NUNCA la pegues en ningun otro sitio
# AI_TEXT_MODEL=""     # id del modelo tal y como lo llame tu proveedor
# AI_TEXT_BASE_URL="https://openrouter.ai/api/v1"

# ---------------------------------------------------------------------------
# Utilidades de desarrollo
# ---------------------------------------------------------------------------

# Ruta a `ffprobe` para el script de verificacion del paquete demo
# (`scripts/qa-visual/`). Solo hace falta si no esta en el PATH.
# FFPROBE="ffprobe"
