# Copia este archivo a .env y ajusta si hace falta.
DATABASE_URL="file:./prisma/dev.db"

# --- Opcionales (server-only, NO se exponen al cliente) ---
# Placeholders futuros: fase de generacion de copy/voz IA (aun no implementada
# en el codigo, ver PLAN.md). Rellenar solo cuando la feature los consuma.
# AI_PROVIDER_KEY="" # server-only — key del proveedor de IA para generar copy
# TTS_API_KEY=""     # server-only — key del proveedor de texto-a-voz

# Secreto para firmar el token efimero de la ruta de render (/preview).
# Opcional: si no se declara, cada proceso genera el suyo al arrancar, que es
# lo correcto con UNA instancia. Con varias, fijalo aqui o las capturas de un
# proceso no validaran contra la ruta servida por otro.
# RENDER_PREVIEW_SECRET=""
